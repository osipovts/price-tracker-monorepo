# Used by the worker (node dist/worker.js)
REDIS_URL=redis://localhost:6379
# Run Camoufox with a window (inside Xvfb in Docker); the site check rejects headless mode.
HEADED=true
# Optional system Camoufox instead of the one installed by Playwright.
# BROWSER_PATH=/usr/bin/chromium
# Jobs handled in parallel by one worker.
JOB_CONCURRENCY=1
# How long a route may take to open a tunnel and a TLS handshake with the site before a browser is opened for
# it: a dead proxy fails in this time instead of a page load that times out.
ROUTE_PROBE_TIMEOUT_MS=6000
# How many Wildberries products of one city one product page reads, from the answer of the card service to it.
WILDBERRIES_BATCH_LIMIT=20
# error, warn, info, debug or verbose (default).
LOG_LEVEL=verbose
